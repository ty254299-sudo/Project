{
  "name": "study-sprout",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "web": "expo start --web",
    "build:web": "expo export --platform web",
    "test:release": "npm run typecheck && npm run test:unit && npm run build:web",
    "serve:preview": "node scripts/serve-static.cjs",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit tests/api tests/ai tests/auth tests/security --pool=threads --no-isolate --no-fsModuleCache",
    "test:integration": "supabase test db",
    "test:integration:api": "vitest run tests/integration/edge-api.test.ts --pool=threads --no-isolate --no-fsModuleCache",
    "test:e2e": "cypress run",
    "test:e2e:open": "cypress open",
    "test:api": "vitest run tests/api --pool=threads --no-isolate --no-fsModuleCache",
    "test:security": "vitest run tests/security --pool=threads --no-isolate --no-fsModuleCache",
    "test:auth": "vitest run tests/auth --pool=threads --no-isolate --no-fsModuleCache",
    "test:ai": "vitest run tests/ai --pool=threads --no-isolate --no-fsModuleCache",
    "eval:ai": "node scripts/eval-ai.mjs"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "~2.2.0",
    "@supabase/supabase-js": "^2.57.0",
    "expo": "~54.0.0",
    "expo-constants": "~18.0.0",
    "expo-font": "~14.0.12",
    "expo-linking": "~8.0.0",
    "expo-router": "~6.0.0",
    "expo-status-bar": "~3.0.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-url-polyfill": "^2.0.0",
    "react-native-web": "^0.21.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.1.13",
    "@types/react": "~19.1.0",
    "cypress": "^16.2.0",
    "postcss": "^8.5.32",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.2",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "postcss": "^8.5.32"
  }
}
