# Local Supabase Edge Function secrets. Never copy these into the Expo app environment.
OPENAI_API_KEY=replace-with-server-secret
OPENAI_MODEL=replace-with-supported-model
# Optional reporting rates. Set from the current provider price sheet for the selected model.
# OPENAI_INPUT_USD_PER_MILLION_TOKENS=
# OPENAI_OUTPUT_USD_PER_MILLION_TOKENS=

# Comma-separated exact browser origins (scheme + host + port, no path).
TRUSTED_WEB_ORIGINS=http://localhost:8081,http://localhost:8082,http://localhost:4174
